# =============================================================================
# CipherSong Web — Template de Variáveis de Ambiente (.env.example)
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores reais do seu ambiente.
# NUNCA faça commit do arquivo `.env` com credenciais reais no repositório Git.
# =============================================================================

# --- 1. Banco de Dados (MongoDB Atlas) ---
# URI de conexão SRV ou Seedlist direta com TLS habilitado
MONGODB_URI="mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/?retryWrites=true&w=majority"
# Opcional: URI seedlist direta para ambientes com restrição de resolução DNS SRV
MONGODB_DIRECT_URI=""
MONGODB_DB_NAME="ciphersong_db"

# --- 2. Criptografia & Sessão (AppSec) ---
# Gere chaves fortes usando: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET="substitua_por_uma_chave_secreta_aleatoria_de_pelo_menos_32_bytes"
SECRET_KEY="substitua_por_uma_chave_secreta_para_o_cofre_aes_256_gcm_local"

# --- 3. Autenticação Google OAuth 2.0 ---
GOOGLE_CLIENT_ID="seu_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="seu_google_client_secret"
GOOGLE_REDIRECT_URL="http://localhost:8000/api/auth/google/callback"

# --- 4. Frontend & Política de CORS ---
# URL pública ou local do frontend React/Vite para redirecionamento pós-login OAuth
FRONTEND_URL="http://localhost:5173"
# Lista de origens permitidas separadas por vírgula para o CORSMiddleware do FastAPI
CORS_ORIGINS="http://localhost:5173,http://localhost:8000,https://ciphersong-web.fly.dev"

# --- 5. E-mail Transacional (Códigos OTP Passwordless) ---
# Opção A: Resend API
RESEND_API_KEY=""
RESEND_FROM="CipherSong <auth@seudominio.com>"

# Opção B: Servidor SMTP Padrão (TLS/SSL)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="CipherSong <auth@seudominio.com>"

# --- 6. Pagamentos e Assinaturas (Stripe Billing & Invoicing) ---
# Modo Teste: use chaves iniciando com pk_test_ e sk_test_
# Modo Produção (Live): use chaves iniciando com pk_live_ e sk_live_
STRIPE_PUBLISHABLE_KEY="pk_live_ou_pk_test_..."
STRIPE_SECRET_KEY="sk_live_ou_sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Opcional (Recomendado em Produção): IDs de Preço (Price IDs) gerados no Stripe Dashboard
# Se omitidos, o backend gera automaticamente os preços dinâmicos em BRL (R$ 14,90/mês, R$ 142,80/ano, R$ 39,90/mês, R$ 382,80/ano)
STRIPE_PRICE_PRO_MONTHLY="price_..."
STRIPE_PRICE_PRO_YEARLY="price_..."
STRIPE_PRICE_MINISTERIO_MONTHLY="price_..."
STRIPE_PRICE_MINISTERIO_YEARLY="price_..."
